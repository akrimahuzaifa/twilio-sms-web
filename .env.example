# Copy to .env for local development. .env is gitignored; never commit real values.
# Everything prefixed VITE_ is embedded in the built JS, so never set these in CI / GitHub variables
# except VITE_TWILIO_FUNCTIONS_URL (see docs/DEPLOYMENT.md).

# Optional: pre-fill sign-in locally (API Key mode). LOCAL ONLY.
VITE_AUTHENTICATION_ACCOUNT_SID=
VITE_AUTHENTICATION_API_KEY=
VITE_AUTHENTICATION_API_SECRET=

# Twilio Functions service used for MMS (send + view media)
VITE_TWILIO_FUNCTIONS_URL=https://alpha-message-6434.twil.io

# Optional
VITE_SMS_SIGNATURE=
VITE_TERMS_AND_CONDITIONS_URL=
VITE_GITHUB_URL=
